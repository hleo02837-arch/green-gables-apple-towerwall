
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Green Gables Towerwall</title>
<style>
*{box-sizing:border-box} body{margin:0;background:#02120c;font-family:Arial;color:#fff}
.page{max-width:430px;margin:0 auto;min-height:100vh;padding:14px;background:radial-gradient(circle at 50% 0%, #0a3d2b, #02120c 60%);border:2px solid #d4af37}
h1{text-align:center;color:#ffd700;letter-spacing:3px;margin:5px 0}
.sub{text-align:center;font-size:11px;letter-spacing:2px;color:#aaffcc}
.shield{width:100px;height:100px;margin:8px auto;background:linear-gradient(#ffe27a,#b8860b);clip-path:polygon(50% 0,100% 15%,100% 55%,50% 100%,0 55%,0 15%);display:flex;align-items:center;justify-content:center;font-size:50px}
.dots{display:flex;justify-content:center;gap:10px;margin:12px 0}
.dots i{width:14px;height:14px;border-radius:50%;border:2px solid #00ff88;display:block}
.dots i.on{background:#00ff88;box-shadow:0 0 12px #00ff88}
.pad{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.pad button{height:55px;background:#0a3d2b;border:2px solid #d4af37;border-radius:12px;color:#fff;font-size:22px;font-weight:bold}
.pad button:active{background:#ffd700;color:#000}
.msg{text-align:center;color:#ffd700;min-height:20px;margin:8px 0}
.back{display:block;text-align:center;color:#fff;margin-top:12px}
</style>
</head>
<body>
<div class="page">
<div style="text-align:center">👑</div>
<div class="shield">🍏</div>
<h1>GREEN GABLES</h1>
<div class="sub">APPLE TOWERWALL SYSTEM</div>
<div class="msg" id="msg">ENTER HADES KEY</div>
<div class="dots" id="dots"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="pad">
<button type="button" onclick="press('1')">1</button>
<button type="button" onclick="press('2')">2</button>
<button type="button" onclick="press('3')">3</button>
<button type="button" onclick="press('4')">4</button>
<button type="button" onclick="press('5')">5</button>
<button type="button" onclick="press('6')">6</button>
<button type="button" onclick="press('7')">7</button>
<button type="button" onclick="press('8')">8</button>
<button type="button" onclick="press('9')">9</button>
<button type="button" onclick="clearAll()">X</button>
<button type="button" onclick="press('0')">0</button>
<button type="button" onclick="back()">⌫</button>
</div>
<div class="msg" id="code">HADES KEY 1.7.7.7</div>
<a class="back" href="index.html">← BACK HOME</a>
</div>
<script>
let typed = "";
function press(n){
  if(typed.length >= 9) return;
  typed += n;
  update();
}
function back(){ typed = typed.slice(0,-1); update(); }
function clearAll(){ typed = ""; update(); }
function update(){
  let dots = document.querySelectorAll("#dots i");
  dots.forEach((d,i)=>{ d.className = i < typed.length ? "on" : ""; });
  document.getElementById("msg").textContent = typed ? "KEY: " + typed : "ENTER HADES KEY";
}
</script>
</body>
</html>
